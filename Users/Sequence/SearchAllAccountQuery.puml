@startuml
actor AdminUser
participant "Admin UI" as UI <<UI>>
participant ":UserEndpoints" as UserEndpoints <<Controller>>
participant ":GetAllAccountCommandHandler" as GetAllAccountCommandHandler <<Handler>>
participant ":IdentityService" as IdentityService <<Service>>

note right of GetAllAccountCommandHandler
  Managed by MediatR
end note

note right of IdentityService
  Managed by IoC
end note

AdminUser -> UI : Search for accounts (by keyword, field, banned status, role)
activate UI
UI -> UserEndpoints : GET /api/User/AllAccounts?keyword=...&fieldName=...&isBanned=...&role=...
activate UserEndpoints
UserEndpoints -> GetAllAccountCommandHandler : Handle(GetAllAccountCommand)
deactivate UserEndpoints
activate GetAllAccountCommandHandler
GetAllAccountCommandHandler -> IdentityService : SearchUserWithRole(searchUserDto)
deactivate GetAllAccountCommandHandler
activate IdentityService
alt Invalid Role
    IdentityService --> GetAllAccountCommandHandler : Error: INVALID_ROLE
    deactivate IdentityService
    activate GetAllAccountCommandHandler
    GetAllAccountCommandHandler -> UserEndpoints : Error: INVALID_ROLE
    deactivate GetAllAccountCommandHandler
    activate UserEndpoints
    UserEndpoints --> UI : 400 Bad Request { "error": "INVALID_ROLE" }
    deactivate UserEndpoints
    UI -> AdminUser : Display error: Invalid role provided
else Search Success
    activate IdentityService
    IdentityService --> GetAllAccountCommandHandler : PaginatedList<UserForListDto>
    deactivate IdentityService
    activate GetAllAccountCommandHandler
    GetAllAccountCommandHandler -> UserEndpoints : PaginatedList<UserForListDto>
    deactivate GetAllAccountCommandHandler
    activate UserEndpoints
    UserEndpoints --> UI : 200 OK (ApiResponse<PaginatedList<UserForListDto>>)
    deactivate UserEndpoints
    UI -> AdminUser : Show search results
end
deactivate UI

@enduml
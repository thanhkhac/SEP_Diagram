@startuml
actor Moderator
participant "Plan List UI" as UI <<UI>>
participant ":PlanEndpoints" as PlanEndpoints <<Controller>>
participant ":SearchPlanQueryHandler" as SearchPlanQueryHandler <<Handler>>
participant ":ApplicationDbContext" as ApplicationDbContext <<DbContext>>
participant Database

note right of SearchPlanQueryHandler
  Managed by MediatR
end note

note right of ApplicationDbContext
  Managed by IoC
end note

Moderator -> UI : View plans / Search plans
activate UI
UI -> PlanEndpoints : GET /api/Plan?isActive=...
activate PlanEndpoints
PlanEndpoints -> SearchPlanQueryHandler : Handle(SearchPlanQuery)
deactivate PlanEndpoints
activate SearchPlanQueryHandler
SearchPlanQueryHandler -> ApplicationDbContext : Query Plans (not deleted)
deactivate SearchPlanQueryHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Query Plans
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : List<Plan>
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> SearchPlanQueryHandler : List<Plan>
deactivate ApplicationDbContext
activate SearchPlanQueryHandler
alt IsActive Filter Provided
    SearchPlanQueryHandler -> SearchPlanQueryHandler : Filter by IsActive
end
SearchPlanQueryHandler -> SearchPlanQueryHandler : Order by Price
SearchPlanQueryHandler -> SearchPlanQueryHandler : Map to List<PlanDetailDto>
SearchPlanQueryHandler -> PlanEndpoints : List<PlanDetailDto>
deactivate SearchPlanQueryHandler
activate PlanEndpoints
PlanEndpoints --> UI : 200 OK (ApiResponse<List<PlanDetailDto>>)
deactivate PlanEndpoints
UI -> Moderator : Show list of plans
deactivate UI

@enduml
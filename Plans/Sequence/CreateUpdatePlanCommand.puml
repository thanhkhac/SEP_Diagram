@startuml
actor Moderator
participant "Plan Management UI" as UI <<UI>>
participant ":PlanEndpoints" as PlanEndpoints <<Controller>>
participant ":CreatePlanCommandHandler" as CreatePlanCommandHandler <<Handler>>
participant ":ApplicationDbContext" as ApplicationDbContext <<DbContext>>
participant Database

note right of CreatePlanCommandHandler
  Managed by MediatR
end note

note right of ApplicationDbContext
  Managed by IoC
end note

Moderator -> UI : Create/Update plan details
activate UI
UI -> PlanEndpoints : POST /api/Plan (or PUT/PATCH)
activate PlanEndpoints
PlanEndpoints -> CreatePlanCommandHandler : Handle(CreatePlanCommand)
deactivate PlanEndpoints
activate CreatePlanCommandHandler
alt PlanId is provided (Update existing plan)
    CreatePlanCommandHandler -> ApplicationDbContext : Query Plan by PlanId
    deactivate CreatePlanCommandHandler
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Query Plan
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : Plan
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> CreatePlanCommandHandler : Plan (existedPlan)
    deactivate ApplicationDbContext
    activate CreatePlanCommandHandler
    alt Plan Not Found
        CreatePlanCommandHandler -> PlanEndpoints : Error: PLAN_NOT_FOUND
        deactivate CreatePlanCommandHandler
        activate PlanEndpoints
        PlanEndpoints --> UI : 400 Bad Request { "error": "PLAN_NOT_FOUND" }
        deactivate PlanEndpoints
        UI -> Moderator : Display error: Plan not found
    else Plan Found
        activate CreatePlanCommandHandler
        CreatePlanCommandHandler -> ApplicationDbContext : Update Plan properties
        deactivate CreatePlanCommandHandler
        activate ApplicationDbContext
        ApplicationDbContext -> Database : Update Plan properties
        deactivate ApplicationDbContext
        activate Database
        Database --> ApplicationDbContext : Success
        deactivate Database
        activate ApplicationDbContext
        ApplicationDbContext --> CreatePlanCommandHandler : Success
        deactivate ApplicationDbContext
        activate CreatePlanCommandHandler
        alt Price Changed
            CreatePlanCommandHandler -> ApplicationDbContext : Query latest PlanPriceHistory
            deactivate CreatePlanCommandHandler
            activate ApplicationDbContext
            ApplicationDbContext -> Database : Query PlanPriceHistory
            deactivate ApplicationDbContext
            activate Database
            Database --> ApplicationDbContext : PlanPriceHistory
            deactivate Database
            activate ApplicationDbContext
            ApplicationDbContext --> CreatePlanCommandHandler : PlanPriceHistory (latestPlanPriceHistory)
            deactivate ApplicationDbContext
            activate CreatePlanCommandHandler
            alt Latest Price History Found
                CreatePlanCommandHandler -> ApplicationDbContext : Update latest PlanPriceHistory (set DateFinish)
                deactivate CreatePlanCommandHandler
                activate ApplicationDbContext
                ApplicationDbContext -> Database : Update PlanPriceHistory
                deactivate ApplicationDbContext
                activate Database
                Database --> ApplicationDbContext : Success
                deactivate Database
                activate ApplicationDbContext
                ApplicationDbContext --> CreatePlanCommandHandler : Success
                deactivate ApplicationDbContext
                activate CreatePlanCommandHandler
            end
            CreatePlanCommandHandler -> ApplicationDbContext : Add new PlanPriceHistory
            deactivate CreatePlanCommandHandler
            activate ApplicationDbContext
            ApplicationDbContext -> Database : Insert PlanPriceHistory
            deactivate ApplicationDbContext
            activate Database
            Database --> ApplicationDbContext : Success
            deactivate Database
            activate ApplicationDbContext
            ApplicationDbContext --> CreatePlanCommandHandler : Success
            deactivate ApplicationDbContext
            activate CreatePlanCommandHandler
        end
        CreatePlanCommandHandler -> ApplicationDbContext : Update Plan Price
        deactivate CreatePlanCommandHandler
        activate ApplicationDbContext
        ApplicationDbContext -> Database : Update Plan
        deactivate ApplicationDbContext
        activate Database
        Database --> ApplicationDbContext : Success
        deactivate Database
        activate ApplicationDbContext
        ApplicationDbContext --> CreatePlanCommandHandler : Guid
        deactivate ApplicationDbContext
        activate CreatePlanCommandHandler
        CreatePlanCommandHandler -> PlanEndpoints : Guid
        deactivate CreatePlanCommandHandler
        activate PlanEndpoints
        PlanEndpoints --> UI : 200 OK (ApiResponse<Guid>)
        deactivate PlanEndpoints
        UI -> Moderator : Display info: Plan updated successfully
    end
else PlanId is null (Create new plan)
    activate CreatePlanCommandHandler
    CreatePlanCommandHandler -> ApplicationDbContext : Add new Plan and PlanPriceHistory
    deactivate CreatePlanCommandHandler
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Insert Plan, PlanPriceHistory
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : Success
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> CreatePlanCommandHandler : Guid
    deactivate ApplicationDbContext
    activate CreatePlanCommandHandler
    CreatePlanCommandHandler -> PlanEndpoints : Guid
    deactivate CreatePlanCommandHandler
    activate PlanEndpoints
    PlanEndpoints --> UI : 200 OK (ApiResponse<Guid>)
    deactivate PlanEndpoints
    UI -> Moderator : Display info: Plan created successfully
end
deactivate UI

@enduml
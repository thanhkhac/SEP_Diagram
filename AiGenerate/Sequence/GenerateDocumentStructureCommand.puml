@startuml
actor User
participant "AI Generate UI" as UI <<UI>>
participant ":AiGenerateEndpoints" as AiGenerateEndpoints <<Controller>>
participant ":GenerateDocumentStructureCommandHandler" as GenerateDocumentStructureCommandHandler <<Handler>>
participant ":AiGenerateService" as AiGenerateService <<Service>>
participant ":ApplicationDbContext" as ApplicationDbContext <<DbContext>>
participant Database
participant ":PromptProvider" as PromptProvider <<Service>>

note right of GenerateDocumentStructureCommandHandler
  Managed by MediatR
end note

note right of AiGenerateService
  Managed by IoC
end note

note right of ApplicationDbContext
  Managed by IoC
end note

note right of PromptProvider
  Managed by IoC
end note

User -> UI : Upload PDF, click "Generate Structure"
activate UI
UI -> AiGenerateEndpoints : POST /api/AiGenerate/DocumentStructure
activate AiGenerateEndpoints
AiGenerateEndpoints -> GenerateDocumentStructureCommandHandler : Handle(GenerateDocumentStructureCommand)
deactivate AiGenerateEndpoints
activate GenerateDocumentStructureCommandHandler
GenerateDocumentStructureCommandHandler -> AiGenerateService : UploadFileAsync(fileData)
deactivate GenerateDocumentStructureCommandHandler
activate AiGenerateService
AiGenerateService --> GenerateDocumentStructureCommandHandler : UploadResult (FileUri, FileName)
deactivate AiGenerateService
activate GenerateDocumentStructureCommandHandler
GenerateDocumentStructureCommandHandler -> PromptProvider : GetGenerateDocumentStructureSystemInstructionPrompt()
deactivate GenerateDocumentStructureCommandHandler
activate PromptProvider
PromptProvider --> GenerateDocumentStructureCommandHandler : SystemInstruction
deactivate PromptProvider
activate GenerateDocumentStructureCommandHandler
GenerateDocumentStructureCommandHandler -> ApplicationDbContext : Query currentUser by UserId
deactivate GenerateDocumentStructureCommandHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Query DomainUser
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : DomainUser
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> GenerateDocumentStructureCommandHandler : DomainUser (currentUser)
deactivate ApplicationDbContext
activate GenerateDocumentStructureCommandHandler
alt Payment Locked
    GenerateDocumentStructureCommandHandler -> AiGenerateEndpoints : Error: PAYMENT_IN_PROGRESS
    deactivate GenerateDocumentStructureCommandHandler
    activate AiGenerateEndpoints
    AiGenerateEndpoints --> UI : 400 Bad Request { "error": "PAYMENT_IN_PROGRESS" }
    deactivate AiGenerateEndpoints
    UI -> User : Display error: Payment in progress
else Payment Not Locked
    activate GenerateDocumentStructureCommandHandler
    GenerateDocumentStructureCommandHandler -> ApplicationDbContext : Set currentUser.IsPaymentLocked = true
    deactivate GenerateDocumentStructureCommandHandler
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Update DomainUser
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : Success
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> GenerateDocumentStructureCommandHandler : Success
    deactivate ApplicationDbContext
    activate GenerateDocumentStructureCommandHandler
    GenerateDocumentStructureCommandHandler -> ApplicationDbContext : Query SystemSettings
    deactivate GenerateDocumentStructureCommandHandler
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Query SystemSettings
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : SystemSetting
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> GenerateDocumentStructureCommandHandler : SystemSetting
    deactivate ApplicationDbContext
    activate GenerateDocumentStructureCommandHandler
    alt System Setting Not Found
        GenerateDocumentStructureCommandHandler -> AiGenerateEndpoints : Error: SYSTEM_SETTING_NOT_FOUND
        deactivate GenerateDocumentStructureCommandHandler
        activate AiGenerateEndpoints
        AiGenerateEndpoints --> UI : 400 Bad Request { "error": "SYSTEM_SETTING_NOT_FOUND" }
        deactivate AiGenerateEndpoints
        UI -> User : Display error: System settings not found
    else System Setting Found
        activate GenerateDocumentStructureCommandHandler
        GenerateDocumentStructureCommandHandler -> AiGenerateService : CountTokenWithFileAsync(fileUri, systemInstruction, prompt)
        deactivate GenerateDocumentStructureCommandHandler
        activate AiGenerateService
        AiGenerateService --> GenerateDocumentStructureCommandHandler : TokenCount
        deactivate AiGenerateService
        activate GenerateDocumentStructureCommandHandler
        alt File Too Large
            GenerateDocumentStructureCommandHandler -> AiGenerateEndpoints : Error: AI_FILE_TOO_LARGE
            deactivate GenerateDocumentStructureCommandHandler
            activate AiGenerateEndpoints
            AiGenerateEndpoints --> UI : 400 Bad Request { "error": "AI_FILE_TOO_LARGE" }
            deactivate AiGenerateEndpoints
            UI -> User : Display error: File too large
        else File Size OK
            activate GenerateDocumentStructureCommandHandler
            GenerateDocumentStructureCommandHandler -> GenerateDocumentStructureCommandHandler : Calculate minimumTotalPoint
            alt Insufficient Balance
                GenerateDocumentStructureCommandHandler -> AiGenerateEndpoints : Error: INSUFFICIENT_BALANCE
                deactivate GenerateDocumentStructureCommandHandler
                activate AiGenerateEndpoints
                AiGenerateEndpoints --> UI : 400 Bad Request { "error": "INSUFFICIENT_BALANCE" }
                deactivate AiGenerateEndpoints
                UI -> User : Display error: Insufficient balance
            else Sufficient Balance
                activate GenerateDocumentStructureCommandHandler
                GenerateDocumentStructureCommandHandler -> AiGenerateService : SendPromptWithFileAsync(...)
                deactivate GenerateDocumentStructureCommandHandler
                activate AiGenerateService
                AiGenerateService --> GenerateDocumentStructureCommandHandler : AI_Response
                deactivate AiGenerateService
                activate GenerateDocumentStructureCommandHandler
                GenerateDocumentStructureCommandHandler -> ApplicationDbContext : Decrease Balance
                deactivate GenerateDocumentStructureCommandHandler
                activate ApplicationDbContext
                ApplicationDbContext -> Database : Update DomainUser
                deactivate ApplicationDbContext
                activate Database
                Database --> ApplicationDbContext : Success
                deactivate Database
                activate ApplicationDbContext
                ApplicationDbContext --> GenerateDocumentStructureCommandHandler : Success
                deactivate ApplicationDbContext
                activate GenerateDocumentStructureCommandHandler
                GenerateDocumentStructureCommandHandler -> AiGenerateService : CountToken(result)
                deactivate GenerateDocumentStructureCommandHandler
                activate AiGenerateService
                AiGenerateService --> GenerateDocumentStructureCommandHandler : OutputTokenCount
                deactivate AiGenerateService
                activate GenerateDocumentStructureCommandHandler
                GenerateDocumentStructureCommandHandler -> GenerateDocumentStructureCommandHandler : Calculate output cost
                GenerateDocumentStructureCommandHandler -> ApplicationDbContext : Decrease Balance (output cost)
                deactivate GenerateDocumentStructureCommandHandler
                activate ApplicationDbContext
                ApplicationDbContext -> Database : Update DomainUser
                deactivate ApplicationDbContext
                activate Database
                Database --> ApplicationDbContext : Success
                deactivate Database
                activate ApplicationDbContext
                ApplicationDbContext --> GenerateDocumentStructureCommandHandler : Success
                deactivate ApplicationDbContext
                activate GenerateDocumentStructureCommandHandler
                GenerateDocumentStructureCommandHandler -> ApplicationDbContext : Set IsPaymentLocked = false
                deactivate GenerateDocumentStructureCommandHandler
                activate ApplicationDbContext
                ApplicationDbContext -> Database : Update DomainUser
                deactivate ApplicationDbContext
                activate Database
                Database --> ApplicationDbContext : Success
                deactivate Database
                activate ApplicationDbContext
                ApplicationDbContext --> GenerateDocumentStructureCommandHandler : Success
                deactivate ApplicationDbContext
                activate GenerateDocumentStructureCommandHandler
                GenerateDocumentStructureCommandHandler -> GenerateDocumentStructureCommandHandler : Extract JSON from AI Response
                alt NO_STRUCTURE_FOUND
                    GenerateDocumentStructureCommandHandler -> AiGenerateEndpoints : Error: NO_STRUCTURE_FOUND
                    deactivate GenerateDocumentStructureCommandHandler
                    activate AiGenerateEndpoints
                    AiGenerateEndpoints --> UI : 400 Bad Request { "error": "NO_STRUCTURE_FOUND" }
                    deactivate AiGenerateEndpoints
                    UI -> User : Display error: No document structure found
                else JSON Deserialization Success
                    activate GenerateDocumentStructureCommandHandler
                    GenerateDocumentStructureCommandHandler -> AiGenerateEndpoints : DocumentStructureDto
                    deactivate GenerateDocumentStructureCommandHandler
                    activate AiGenerateEndpoints
                    AiGenerateEndpoints --> UI : 200 OK (ApiResponse<DocumentStructureDto>)
                    deactivate AiGenerateEndpoints
                    UI -> User : Show generated document structure
   activate GenerateDocumentStructureCommandHandler

                end
            end
        end
    end
end
deactivate UI
GenerateDocumentStructureCommandHandler -> ApplicationDbContext : Set IsPaymentLocked = false
deactivate GenerateDocumentStructureCommandHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Update DomainUser
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : Success
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> GenerateDocumentStructureCommandHandler : Success
deactivate ApplicationDbContext
activate GenerateDocumentStructureCommandHandler
GenerateDocumentStructureCommandHandler -> AiGenerateService : DeleteFileAsync(fileName)
deactivate GenerateDocumentStructureCommandHandler
activate AiGenerateService
AiGenerateService --> GenerateDocumentStructureCommandHandler : Success
deactivate AiGenerateService
activate GenerateDocumentStructureCommandHandler
deactivate GenerateDocumentStructureCommandHandler
deactivate AiGenerateEndpoints
deactivate UI

@enduml
@startuml
actor User
participant "AI Generate UI" as UI <<UI>>
participant ":AiGenerateEndpoints" as AiGenerateEndpoints <<Controller>>
participant ":GenerateQuestionWithAiCommandHandler" as GenerateQuestionWithAiCommandHandler <<Handler>>
participant ":AiGenerateService" as AiGenerateService <<Service>>
participant ":ApplicationDbContext" as ApplicationDbContext <<DbContext>>
participant Database
participant ":PromptProvider" as PromptProvider <<Service>>

note right of GenerateQuestionWithAiCommandHandler
  Managed by MediatR
end note

note right of AiGenerateService
  Managed by IoC
end note

note right of ApplicationDbContext
  Managed by IoC
end note

note right of PromptProvider
  Managed by IoC
end note

User -> UI : Upload PDF, select parts, types, count, click "Generate Questions"
activate UI
UI -> AiGenerateEndpoints : POST /api/AiGenerate/Questions
activate AiGenerateEndpoints
AiGenerateEndpoints -> GenerateQuestionWithAiCommandHandler : Handle(GenerateQuestionWithAiCommand)
deactivate AiGenerateEndpoints
activate GenerateQuestionWithAiCommandHandler
GenerateQuestionWithAiCommandHandler -> AiGenerateService : UploadFileAsync(fileData)
deactivate GenerateQuestionWithAiCommandHandler
activate AiGenerateService
AiGenerateService --> GenerateQuestionWithAiCommandHandler : UploadResult (FileUri, FileName)
deactivate AiGenerateService
activate GenerateQuestionWithAiCommandHandler
GenerateQuestionWithAiCommandHandler -> PromptProvider : GetGenerateQuestionInstructionSystemPrompt(...)
deactivate GenerateQuestionWithAiCommandHandler
activate PromptProvider
PromptProvider --> GenerateQuestionWithAiCommandHandler : SystemInstruction
activate GenerateQuestionWithAiCommandHandler
GenerateQuestionWithAiCommandHandler -> PromptProvider : GetGenerateQuestionPrompt(...)
deactivate GenerateQuestionWithAiCommandHandler
PromptProvider --> GenerateQuestionWithAiCommandHandler : Prompt
deactivate PromptProvider
activate GenerateQuestionWithAiCommandHandler
GenerateQuestionWithAiCommandHandler -> ApplicationDbContext : Query currentUser by UserId
deactivate GenerateQuestionWithAiCommandHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Query DomainUser
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : DomainUser
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> GenerateQuestionWithAiCommandHandler : DomainUser (currentUser)
deactivate ApplicationDbContext
activate GenerateQuestionWithAiCommandHandler
alt Payment Locked
    GenerateQuestionWithAiCommandHandler -> AiGenerateEndpoints : Error: PAYMENT_IN_PROGRESS
    deactivate GenerateQuestionWithAiCommandHandler
    activate AiGenerateEndpoints
    AiGenerateEndpoints --> UI : 400 Bad Request { "error": "PAYMENT_IN_PROGRESS" }
    deactivate AiGenerateEndpoints
    UI -> User : Display error: Payment in progress
else Payment Not Locked
    activate GenerateQuestionWithAiCommandHandler
    GenerateQuestionWithAiCommandHandler -> ApplicationDbContext : Set currentUser.IsPaymentLocked = true
    deactivate GenerateQuestionWithAiCommandHandler
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Update DomainUser
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : Success
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> GenerateQuestionWithAiCommandHandler : Success
    deactivate ApplicationDbContext
    activate GenerateQuestionWithAiCommandHandler
    GenerateQuestionWithAiCommandHandler -> ApplicationDbContext : Query SystemSettings
    deactivate GenerateQuestionWithAiCommandHandler
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Query SystemSettings
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : SystemSetting
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> GenerateQuestionWithAiCommandHandler : SystemSetting
    deactivate ApplicationDbContext
    activate GenerateQuestionWithAiCommandHandler
    alt System Setting Not Found
        GenerateQuestionWithAiCommandHandler -> AiGenerateEndpoints : Error: SYSTEM_SETTING_NOT_FOUND
        deactivate GenerateQuestionWithAiCommandHandler
        activate AiGenerateEndpoints
        AiGenerateEndpoints --> UI : 400 Bad Request { "error": "SYSTEM_SETTING_NOT_FOUND" }
        deactivate AiGenerateEndpoints
        UI -> User : Display error: System settings not found
    else System Setting Found
        activate GenerateQuestionWithAiCommandHandler
        GenerateQuestionWithAiCommandHandler -> AiGenerateService : CountTokenWithFileAsync(fileUri, systemInstruction, prompt)
        deactivate GenerateQuestionWithAiCommandHandler
        activate AiGenerateService
        AiGenerateService --> GenerateQuestionWithAiCommandHandler : TokenCount
        deactivate AiGenerateService
        activate GenerateQuestionWithAiCommandHandler
        alt File Too Large
            GenerateQuestionWithAiCommandHandler -> AiGenerateEndpoints : Error: AI_FILE_TOO_LARGE
            deactivate GenerateQuestionWithAiCommandHandler
            activate AiGenerateEndpoints
            AiGenerateEndpoints --> UI : 400 Bad Request { "error": "AI_FILE_TOO_LARGE" }
            deactivate AiGenerateEndpoints
            UI -> User : Display error: File too large
        else File Size OK
            activate GenerateQuestionWithAiCommandHandler
            GenerateQuestionWithAiCommandHandler -> GenerateQuestionWithAiCommandHandler : Calculate minimumTotalPoint
            alt Insufficient Balance
                GenerateQuestionWithAiCommandHandler -> AiGenerateEndpoints : Error: INSUFFICIENT_BALANCE
                deactivate GenerateQuestionWithAiCommandHandler
                activate AiGenerateEndpoints
                AiGenerateEndpoints --> UI : 400 Bad Request { "error": "INSUFFICIENT_BALANCE" }
                deactivate AiGenerateEndpoints
                UI -> User : Display error: Insufficient balance
            else Sufficient Balance
                activate GenerateQuestionWithAiCommandHandler
                GenerateQuestionWithAiCommandHandler -> AiGenerateService : SendPromptWithFileAsync(...)
                deactivate GenerateQuestionWithAiCommandHandler
                activate AiGenerateService
                AiGenerateService --> GenerateQuestionWithAiCommandHandler : AI_Response
                deactivate AiGenerateService
                activate GenerateQuestionWithAiCommandHandler
                GenerateQuestionWithAiCommandHandler -> ApplicationDbContext : Decrease Balance
                deactivate GenerateQuestionWithAiCommandHandler
                activate ApplicationDbContext
                ApplicationDbContext -> Database : Update DomainUser
                deactivate ApplicationDbContext
                activate Database
                Database --> ApplicationDbContext : Success
                deactivate Database
                activate ApplicationDbContext
                ApplicationDbContext --> GenerateQuestionWithAiCommandHandler : Success
                deactivate ApplicationDbContext
                activate GenerateQuestionWithAiCommandHandler
                GenerateQuestionWithAiCommandHandler -> AiGenerateService : CountToken(result)
                deactivate GenerateQuestionWithAiCommandHandler
                activate AiGenerateService
                AiGenerateService --> GenerateQuestionWithAiCommandHandler : OutputTokenCount
                deactivate AiGenerateService
                activate GenerateQuestionWithAiCommandHandler
                GenerateQuestionWithAiCommandHandler -> GenerateQuestionWithAiCommandHandler : Calculate output cost
                GenerateQuestionWithAiCommandHandler -> ApplicationDbContext : Decrease Balance (output cost)
                deactivate GenerateQuestionWithAiCommandHandler
                activate ApplicationDbContext
                ApplicationDbContext -> Database : Update DomainUser
                deactivate ApplicationDbContext
                activate Database
                Database --> ApplicationDbContext : Success
                deactivate Database
                activate ApplicationDbContext
                ApplicationDbContext --> GenerateQuestionWithAiCommandHandler : Success
                deactivate ApplicationDbContext
                activate GenerateQuestionWithAiCommandHandler
                GenerateQuestionWithAiCommandHandler -> ApplicationDbContext : Set IsPaymentLocked = false
                deactivate GenerateQuestionWithAiCommandHandler
                activate ApplicationDbContext
                ApplicationDbContext -> Database : Update DomainUser
                deactivate ApplicationDbContext
                activate Database
                Database --> ApplicationDbContext : Success
                deactivate Database
                activate ApplicationDbContext
                ApplicationDbContext --> GenerateQuestionWithAiCommandHandler : Success
                deactivate ApplicationDbContext
                activate GenerateQuestionWithAiCommandHandler
                GenerateQuestionWithAiCommandHandler -> GenerateQuestionWithAiCommandHandler : Extract JSON from AI Response
                alt NO_STRUCTURE_FOUND
                    GenerateQuestionWithAiCommandHandler -> AiGenerateEndpoints : Error: NO_STRUCTURE_FOUND
                    deactivate GenerateQuestionWithAiCommandHandler
                    activate AiGenerateEndpoints
                    AiGenerateEndpoints --> UI : 400 Bad Request { "error": "NO_STRUCTURE_FOUND" }
                    deactivate AiGenerateEndpoints
                    UI -> User : Display error: No structure found
                else JSON Deserialization Success
                    activate GenerateQuestionWithAiCommandHandler
                    GenerateQuestionWithAiCommandHandler -> AiGenerateEndpoints : List<CreateUpdateQuestionDto>
                    deactivate GenerateQuestionWithAiCommandHandler
                    activate AiGenerateEndpoints
                    AiGenerateEndpoints --> UI : 200 OK (ApiResponse<List<CreateUpdateQuestionDto>>)
                    deactivate AiGenerateEndpoints
                    UI -> User : Show generated questions
        activate GenerateQuestionWithAiCommandHandler
                end
            end
        end
    end
end

GenerateQuestionWithAiCommandHandler -> ApplicationDbContext : Set IsPaymentLocked = false
deactivate GenerateQuestionWithAiCommandHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Update DomainUser
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : Success
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> GenerateQuestionWithAiCommandHandler : Success
deactivate ApplicationDbContext
activate GenerateQuestionWithAiCommandHandler
GenerateQuestionWithAiCommandHandler -> AiGenerateService : DeleteFileAsync(fileName)
deactivate GenerateQuestionWithAiCommandHandler
activate AiGenerateService
AiGenerateService --> GenerateQuestionWithAiCommandHandler : Success
deactivate AiGenerateService
activate GenerateQuestionWithAiCommandHandler
deactivate GenerateQuestionWithAiCommandHandler
deactivate AiGenerateEndpoints
deactivate UI

@enduml
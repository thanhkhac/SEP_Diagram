@startuml
actor User
participant "Folder Sharing UI" as UI <<UI>>
participant ":FolderTestEndpoints" as FolderTestEndpoints <<Controller>>
participant ":UpdateSharingInFolderCommandHandler" as UpdateSharingInFolderCommandHandler <<Handler>>
participant ":FolderTestService" as FolderTestService <<Service>>
participant ":ApplicationDbContext" as ApplicationDbContext <<DbContext>>
participant Database

note right of UpdateSharingInFolderCommandHandler
  Managed by MediatR
end note

note right of FolderTestService
  Managed by IoC
end note

note right of ApplicationDbContext
  Managed by IoC
end note

User -> UI : Update sharing settings
activate UI
UI -> FolderTestEndpoints : PATCH /api/Folder/{FolderId}/Sharing
activate FolderTestEndpoints
FolderTestEndpoints -> UpdateSharingInFolderCommandHandler : Handle(UpdateSharingInFolderCommand)
deactivate FolderTestEndpoints
activate UpdateSharingInFolderCommandHandler
UpdateSharingInFolderCommandHandler -> ApplicationDbContext : Query Folder by FolderId
deactivate UpdateSharingInFolderCommandHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Query Folder
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : Folder
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> UpdateSharingInFolderCommandHandler : Folder
deactivate ApplicationDbContext
activate UpdateSharingInFolderCommandHandler
alt Folder Not Found
    UpdateSharingInFolderCommandHandler -> FolderTestEndpoints : Error: FOLDER_NOT_FOUND
    deactivate UpdateSharingInFolderCommandHandler
    activate FolderTestEndpoints
    FolderTestEndpoints --> UI : 400 Bad Request { "error": "FOLDER_NOT_FOUND" }
    deactivate FolderTestEndpoints
    UI -> User : Display error: Folder not found
else Folder Found
    activate UpdateSharingInFolderCommandHandler
    UpdateSharingInFolderCommandHandler -> FolderTestService : IsOwnerOrEditor(folderId)
    deactivate UpdateSharingInFolderCommandHandler
    activate FolderTestService
    FolderTestService -> ApplicationDbContext : Query Permission
    deactivate FolderTestService
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Query Permission
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : Permission
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> FolderTestService : Permission
    deactivate ApplicationDbContext
    activate FolderTestService
    FolderTestService --> UpdateSharingInFolderCommandHandler : bool
    deactivate FolderTestService
    activate UpdateSharingInFolderCommandHandler
    alt No permission
        UpdateSharingInFolderCommandHandler -> FolderTestEndpoints : Error: COMMON_FORBIDDEN
        deactivate UpdateSharingInFolderCommandHandler
        activate FolderTestEndpoints
        FolderTestEndpoints --> UI : 400 Bad Request { "error": "COMMON_FORBIDDEN" }
        deactivate FolderTestEndpoints
        UI -> User : Display error: User does not have permission in folder
    else Allowed
        activate UpdateSharingInFolderCommandHandler
        UpdateSharingInFolderCommandHandler -> ApplicationDbContext : Query existing DomainUsers for SharingModels
        deactivate UpdateSharingInFolderCommandHandler
        activate ApplicationDbContext
        ApplicationDbContext -> Database : Query DomainUsers
        deactivate ApplicationDbContext
        activate Database
        Database --> ApplicationDbContext : List<DomainUser>
        deactivate Database
        activate ApplicationDbContext
        ApplicationDbContext --> UpdateSharingInFolderCommandHandler : List<DomainUser>
        deactivate ApplicationDbContext
        activate UpdateSharingInFolderCommandHandler
        alt Invalid SharingUserIds
            UpdateSharingInFolderCommandHandler -> FolderTestEndpoints : Error: USER_NOT_FOUND
            deactivate UpdateSharingInFolderCommandHandler
            activate FolderTestEndpoints
            FolderTestEndpoints --> UI : 400 Bad Request { "error": "USER_NOT_FOUND" }
            deactivate FolderTestEndpoints
            UI -> User : Display error: Invalid user(s) in sharing list
        else Valid SharingUserIds
            activate UpdateSharingInFolderCommandHandler
            UpdateSharingInFolderCommandHandler -> ApplicationDbContext : Query existing FolderUsers
            deactivate UpdateSharingInFolderCommandHandler
            activate ApplicationDbContext
            ApplicationDbContext -> Database : Query FolderUsers
            deactivate ApplicationDbContext
            activate Database
            Database --> ApplicationDbContext : List<FolderUser>
            deactivate Database
            activate ApplicationDbContext
            ApplicationDbContext --> UpdateSharingInFolderCommandHandler : List<FolderUser>
            deactivate ApplicationDbContext
            activate UpdateSharingInFolderCommandHandler
            loop For each SharingModel
                UpdateSharingInFolderCommandHandler -> ApplicationDbContext : Update or Add FolderUser
                ' deactivate UpdateSharingInFolderCommandHandler
                ' activate ApplicationDbContext
                ' ApplicationDbContext -> Database : Update/Insert FolderUser
                ' deactivate ApplicationDbContext
                ' activate Database
                ' Database --> ApplicationDbContext : Success
                ' deactivate Database
                ' activate ApplicationDbContext
                ' deactivate ApplicationDbContext
                ' activate UpdateSharingInFolderCommandHandler
            end
            UpdateSharingInFolderCommandHandler -> ApplicationDbContext : Remove FolderUsers for DeleteUserIds
            deactivate UpdateSharingInFolderCommandHandler
            activate ApplicationDbContext
            ApplicationDbContext -> Database : Delete FolderUsers
            deactivate ApplicationDbContext
            activate Database
            Database --> ApplicationDbContext : Success
            deactivate Database
            activate ApplicationDbContext
            ApplicationDbContext --> UpdateSharingInFolderCommandHandler : Guid
            deactivate ApplicationDbContext
            activate UpdateSharingInFolderCommandHandler
            UpdateSharingInFolderCommandHandler -> FolderTestEndpoints : Guid
            deactivate UpdateSharingInFolderCommandHandler
            activate FolderTestEndpoints
            FolderTestEndpoints --> UI : 200 OK (ApiResponse<Guid>)
            deactivate FolderTestEndpoints
            UI -> User : Display info: Sharing settings updated
        end
    end
end
deactivate UI

@enduml
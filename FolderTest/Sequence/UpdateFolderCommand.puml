@startuml
actor User
participant "Edit Folder UI" as UI <<UI>>
participant ":FolderTestEndpoints" as FolderTestEndpoints <<Controller>>
participant ":UpdateFolderCommandHandler" as UpdateFolderCommandHandler <<Handler>>
participant ":FolderTestService" as FolderTestService <<Service>>
participant ":ApplicationDbContext" as ApplicationDbContext <<DbContext>>
participant Database

note right of UpdateFolderCommandHandler
  Managed by MediatR
end note

note right of FolderTestService
  Managed by IoC
end note

note right of ApplicationDbContext
  Managed by IoC
end note

User -> UI : Edit folder name, click "Save"
activate UI
UI -> FolderTestEndpoints : PATCH /api/Folder/{FolderId}
activate FolderTestEndpoints
FolderTestEndpoints -> UpdateFolderCommandHandler : Handle(UpdateFolderCommand)
deactivate FolderTestEndpoints
activate UpdateFolderCommandHandler
UpdateFolderCommandHandler -> ApplicationDbContext : Query Folder by FolderId
deactivate UpdateFolderCommandHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Query Folder
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : Folder
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> UpdateFolderCommandHandler : Folder
deactivate ApplicationDbContext
activate UpdateFolderCommandHandler
alt Folder Not Found
    UpdateFolderCommandHandler -> FolderTestEndpoints : Error: FOLDER_NOT_FOUND
    deactivate UpdateFolderCommandHandler
    activate FolderTestEndpoints
    FolderTestEndpoints --> UI : 400 Bad Request { "error": "FOLDER_NOT_FOUND" }
    deactivate FolderTestEndpoints
    UI -> User : Display error: Folder not found
else Folder Found
    activate UpdateFolderCommandHandler
    UpdateFolderCommandHandler -> FolderTestService : IsOwnerOrEditor(folderId)
    deactivate UpdateFolderCommandHandler
    activate FolderTestService
    FolderTestService -> ApplicationDbContext : Query Permission
    deactivate FolderTestService
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Query Permission
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : Permission
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> FolderTestService : Permission
    deactivate ApplicationDbContext
    activate FolderTestService
    FolderTestService --> UpdateFolderCommandHandler : bool
    deactivate FolderTestService
    activate UpdateFolderCommandHandler
    alt No permission
        UpdateFolderCommandHandler -> FolderTestEndpoints : Error: COMMON_FORBIDDEN
        deactivate UpdateFolderCommandHandler
        activate FolderTestEndpoints
        FolderTestEndpoints --> UI : 400 Bad Request { "error": "COMMON_FORBIDDEN" }
        deactivate FolderTestEndpoints
        UI -> User : Display error: User does not have permission to edit folder
    else Allowed
        activate UpdateFolderCommandHandler
        UpdateFolderCommandHandler -> ApplicationDbContext : Query Folder by Name and CreatedBy (for duplicate check)
        deactivate UpdateFolderCommandHandler
        activate ApplicationDbContext
        ApplicationDbContext -> Database : Query Folder
        deactivate ApplicationDbContext
        activate Database
        Database --> ApplicationDbContext : Folder
        deactivate Database
        activate ApplicationDbContext
        ApplicationDbContext --> UpdateFolderCommandHandler : Folder (folderByName)
        deactivate ApplicationDbContext
        activate UpdateFolderCommandHandler
        alt Folder Name Already Exists
            UpdateFolderCommandHandler -> FolderTestEndpoints : Error: FOLDER_ALREADY_EXISTS
            deactivate UpdateFolderCommandHandler
            activate FolderTestEndpoints
            FolderTestEndpoints --> UI : 400 Bad Request { "error": "FOLDER_ALREADY_EXISTS" }
            deactivate FolderTestEndpoints
            UI -> User : Display error: Folder name already exists
        else Folder Name Unique
            activate UpdateFolderCommandHandler
            UpdateFolderCommandHandler -> ApplicationDbContext : Update Folder Name
            deactivate UpdateFolderCommandHandler
            activate ApplicationDbContext
            ApplicationDbContext -> Database : Update Folder
            deactivate ApplicationDbContext
            activate Database
            Database --> ApplicationDbContext : Success
            deactivate Database
            activate ApplicationDbContext
            ApplicationDbContext --> UpdateFolderCommandHandler : Guid
            deactivate ApplicationDbContext
            activate UpdateFolderCommandHandler
            UpdateFolderCommandHandler -> FolderTestEndpoints : Guid
            deactivate UpdateFolderCommandHandler
            activate FolderTestEndpoints
            FolderTestEndpoints --> UI : 200 OK (ApiResponse<Guid>)
            deactivate FolderTestEndpoints
            UI -> User : Display info: Folder updated successfully
        end
    end
end
deactivate UI

@enduml
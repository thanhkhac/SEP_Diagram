@startuml
actor User
participant "Folder List UI" as UI <<UI>>
participant ":FolderTestEndpoints" as FolderTestEndpoints <<Controller>>
participant ":DeleteFolderCommandHandler" as DeleteFolderCommandHandler <<Handler>>
participant ":FolderTestService" as FolderTestService <<Service>>
participant ":ApplicationDbContext" as ApplicationDbContext <<DbContext>>
participant ":IdentityService" as IdentityService <<Service>>
participant Database

note right of DeleteFolderCommandHandler
  Managed by MediatR
end note

note right of FolderTestService
  Managed by IoC
end note

note right of ApplicationDbContext
  Managed by IoC
end note

note right of IdentityService
  Managed by IoC
end note

User -> UI : Click "Delete"
activate UI
UI -> FolderTestEndpoints : DELETE /api/Folder/{FolderId}
activate FolderTestEndpoints
FolderTestEndpoints -> DeleteFolderCommandHandler : Handle(DeleteFolderCommand)
deactivate FolderTestEndpoints
activate DeleteFolderCommandHandler
DeleteFolderCommandHandler -> ApplicationDbContext : Query Folder by FolderId
deactivate DeleteFolderCommandHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Query Folder
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : Folder
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> DeleteFolderCommandHandler : Folder
deactivate ApplicationDbContext
activate DeleteFolderCommandHandler
alt Folder Not Found
    DeleteFolderCommandHandler -> FolderTestEndpoints : Error: FOLDER_NOT_FOUND
    deactivate DeleteFolderCommandHandler
    activate FolderTestEndpoints
    FolderTestEndpoints --> UI : 400 Bad Request { "error": "FOLDER_NOT_FOUND" }
    deactivate FolderTestEndpoints
    UI -> User : Display error: Folder not found
else Folder Found
    activate DeleteFolderCommandHandler
    DeleteFolderCommandHandler -> FolderTestService : CanDeleteOrEditFolderTest(folderId)
    deactivate DeleteFolderCommandHandler
    activate FolderTestService
    FolderTestService -> IdentityService : IsInAnyRoleAsync(userId, Administrator, Moderator)
    deactivate FolderTestService
    activate IdentityService
    IdentityService --> FolderTestService : bool (isAdmin)
    deactivate IdentityService
    activate FolderTestService
    alt Is Admin
        FolderTestService --> DeleteFolderCommandHandler : true
    else Not Admin
        ' activate FolderTestService
        FolderTestService -> ApplicationDbContext : Query FolderUser (Owner)
        deactivate FolderTestService
        activate ApplicationDbContext
        ApplicationDbContext -> Database : Query FolderUser
        deactivate ApplicationDbContext
        activate Database
        Database --> ApplicationDbContext : FolderUser
        deactivate Database
        activate ApplicationDbContext
        ApplicationDbContext --> FolderTestService : FolderUser
        deactivate ApplicationDbContext
        activate FolderTestService
        FolderTestService --> DeleteFolderCommandHandler : bool (isOwner)
    end
    deactivate FolderTestService
    activate DeleteFolderCommandHandler
    alt No permission
        DeleteFolderCommandHandler -> FolderTestEndpoints : Error: COMMON_FORBIDDEN
        deactivate DeleteFolderCommandHandler
        activate FolderTestEndpoints
        FolderTestEndpoints --> UI : 400 Bad Request { "error": "COMMON_FORBIDDEN" }
        deactivate FolderTestEndpoints
        UI -> User : Display error: User does not have permission to delete folder
    else Allowed
        activate DeleteFolderCommandHandler
        DeleteFolderCommandHandler -> ApplicationDbContext : Mark Folder as Deleted
        deactivate DeleteFolderCommandHandler
        activate ApplicationDbContext
        ApplicationDbContext -> Database : Update Folder (IsDeleted = true)
        deactivate ApplicationDbContext
        activate Database
        Database --> ApplicationDbContext : Success
        deactivate Database
        activate ApplicationDbContext
        ApplicationDbContext --> DeleteFolderCommandHandler : Guid
        deactivate ApplicationDbContext
        activate DeleteFolderCommandHandler
        DeleteFolderCommandHandler -> FolderTestEndpoints : Guid
        deactivate DeleteFolderCommandHandler
        activate FolderTestEndpoints
        FolderTestEndpoints --> UI : 200 OK (ApiResponse<Guid>)
        deactivate FolderTestEndpoints
        UI -> User : Display info: Folder deleted successfully
    end
end
deactivate UI

@enduml
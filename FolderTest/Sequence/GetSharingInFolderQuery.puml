@startuml
actor User
participant "Folder Detail UI" as UI <<UI>>
participant ":FolderTestEndpoints" as FolderTestEndpoints <<Controller>>
participant ":GetSharingInFolderQueryHandler" as GetSharingInFolderQueryHandler <<Handler>>
participant ":FolderTestService" as FolderTestService <<Service>>
participant ":ApplicationDbContext" as ApplicationDbContext <<DbContext>>
participant Database

note right of GetSharingInFolderQueryHandler
  Managed by MediatR
end note

note right of FolderTestService
  Managed by IoC
end note

note right of ApplicationDbContext
  Managed by IoC
end note

User -> UI : View sharing details
activate UI
UI -> FolderTestEndpoints : GET /api/Folder/{FolderId}/Sharing
activate FolderTestEndpoints
FolderTestEndpoints -> GetSharingInFolderQueryHandler : Handle(GetSharingInFolderQuery)
deactivate FolderTestEndpoints
activate GetSharingInFolderQueryHandler
GetSharingInFolderQueryHandler -> ApplicationDbContext : Query Folder by FolderId
deactivate GetSharingInFolderQueryHandler
activate ApplicationDbContext
ApplicationDbContext -> Database : Query Folder
deactivate ApplicationDbContext
activate Database
Database --> ApplicationDbContext : Folder
deactivate Database
activate ApplicationDbContext
ApplicationDbContext --> GetSharingInFolderQueryHandler : Folder
deactivate ApplicationDbContext
activate GetSharingInFolderQueryHandler
alt Folder Not Found
    GetSharingInFolderQueryHandler -> FolderTestEndpoints : Error: FOLDER_NOT_FOUND
    deactivate GetSharingInFolderQueryHandler
    activate FolderTestEndpoints
    FolderTestEndpoints --> UI : 400 Bad Request { "error": "FOLDER_NOT_FOUND" }
    deactivate FolderTestEndpoints
    UI -> User : Display error: Folder not found
else Folder Found
    activate GetSharingInFolderQueryHandler
    GetSharingInFolderQueryHandler -> FolderTestService : IsOwnerOrEditor(folderId)
    deactivate GetSharingInFolderQueryHandler
    activate FolderTestService
    FolderTestService -> ApplicationDbContext : Query Permission
    deactivate FolderTestService
    activate ApplicationDbContext
    ApplicationDbContext -> Database : Query Permission
    deactivate ApplicationDbContext
    activate Database
    Database --> ApplicationDbContext : Permission
    deactivate Database
    activate ApplicationDbContext
    ApplicationDbContext --> FolderTestService : Permission
    deactivate ApplicationDbContext
    activate FolderTestService
    FolderTestService --> GetSharingInFolderQueryHandler : bool
    deactivate FolderTestService
    activate GetSharingInFolderQueryHandler
    alt No permission
        GetSharingInFolderQueryHandler -> FolderTestEndpoints : Error: COMMON_FORBIDDEN
        deactivate GetSharingInFolderQueryHandler
        activate FolderTestEndpoints
        FolderTestEndpoints --> UI : 400 Bad Request { "error": "COMMON_FORBIDDEN" }
        deactivate FolderTestEndpoints
        UI -> User : Display error: User does not have permission in folder
    else Allowed
        activate GetSharingInFolderQueryHandler
        GetSharingInFolderQueryHandler -> ApplicationDbContext : Query FolderUsers by FolderId
        deactivate GetSharingInFolderQueryHandler
        activate ApplicationDbContext
        ApplicationDbContext -> Database : Query FolderUsers
        deactivate ApplicationDbContext
        activate Database
        Database --> ApplicationDbContext : List<FolderUser>
        deactivate Database
        activate ApplicationDbContext
        ApplicationDbContext --> GetSharingInFolderQueryHandler : List<FolderUser>
        deactivate ApplicationDbContext
        activate GetSharingInFolderQueryHandler
        GetSharingInFolderQueryHandler -> GetSharingInFolderQueryHandler : Map to SharingModelDto
        GetSharingInFolderQueryHandler -> FolderTestEndpoints : ResourceShareDto
        deactivate GetSharingInFolderQueryHandler
        activate FolderTestEndpoints
        FolderTestEndpoints --> UI : 200 OK (ApiResponse<ResourceShareDto>)
        deactivate FolderTestEndpoints
        UI -> User : Show sharing details
    end
end
deactivate UI

@enduml